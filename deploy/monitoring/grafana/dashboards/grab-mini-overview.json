  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Service Health & HTTP Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "DOWN" },
                "1": { "color": "green", "index": 0, "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "up{job!=\"prometheus\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Go Services Status (/metrics scrape)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (job, route, code) (rate(http_requests_total[1m]))",
          "legendFormat": "{{job}} {{route}} ({{code}})",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate (by Route & Status)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, route) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{job}} {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, job, route) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{job}} {{route}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Request Latency (p50 & p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 5,
      "panels": [],
      "title": "Ride-Booking Business Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (vehicle_type) (rate(orders_created_total[1m]))",
          "legendFormat": "created ({{vehicle_type}})",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (rate(matching_orders_total[1m]))",
          "legendFormat": "matching: {{result}}",
          "refId": "B"
        }
      ],
      "title": "Orders Created & Matching Outcomes Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(matching_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 match latency (SLO: 3s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(matching_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 match latency",
          "refId": "B"
        }
      ],
      "title": "Driver Matching Latency (SLO: p95 < 3s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (status) (increase(trip_transitions_total[5m]))",
          "legendFormat": "trip -> {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (increase(ratings_recorded_total[5m]))",
          "legendFormat": "rating: {{result}}",
          "refId": "B"
        },
        {
          "expr": "sum by (kind) (notification_sockets_open)",
          "legendFormat": "ws open: {{kind}}",
          "refId": "C"
        }
      ],
      "title": "Trips, Ratings & Open WebSockets",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 9,
      "panels": [],
      "title": "Kafka Event Streaming, Outbox & Location Pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (group, topic, result) (rate(kafka_consumer_messages_total[1m]))",
