          "legendFormat": "p95 publish ({{topic}})",
          "refId": "B"
        }
      ],
      "title": "Outbox Pending Age & Kafka Publish Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (result) (rate(location_reports_total[1m]))",
          "legendFormat": "gateway: {{result}}",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (rate(location_updates_total[1m]))",
          "legendFormat": "consumer: {{result}}",
          "refId": "B"
        },
        {
          "expr": "max by (vehicle_type) (pricing_surge_multiplier_max)",
